# Alpaca paper trading + market data
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Optional: iex (free) or sip/boats
ALPACA_DATA_FEED=iex

# OpenAI — AI indicators, strategies, scan catalyst summaries
OPENAI_API_KEY=

# Admin page password
ADMIN_PASSWORD=

# Firebase (client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server) — enables Firestore persistence
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# TopStep / Apex futures (shared fallback — per-user accounts live in Firestore)
TOPSTEP_USERNAME=
TOPSTEP_API_KEY=
TOPSTEP_ACCOUNT_ID=
APEX_USERNAME=
APEX_API_KEY=
APEX_ACCOUNT_ID=

# FOREX.com (GAIN Capital TradingAPI) — live or demo account; AppKey from support.en@forex.com
FOREX_USERNAME=
FOREX_PASSWORD=
FOREX_APP_KEY=
# FOREX_BASE_URL=https://ciapi.cityindex.com/TradingAPI   # optional override

# Telegram scanner alerts (shared fallback — per-user creds via /scanner settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vercel cron — Authorization Bearer for /api/scanner/tick
CRON_SECRET=

# Email — broker API-key setup instructions (Resend; without it the UI falls back to mailto:)
RESEND_API_KEY=
EMAIL_FROM=alerts@yourdomain.com

# Local AI (Fin-R1 via LM Studio) — used for analysis tasks: optimizer
# result reasoning and news catalyst summaries. OpenAI remains the fallback
# and stays responsible for strategy/indicator code generation.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=fin-r1

TOPSTEP_USERNAME — platform login name (not email)
TOPSTEP_API_KEY — from TopStep → Settings → API
TOPSTEP_ACCOUNT_ID — numeric account id (yours: 28222073)
TOPSTEP_BASE_URL — optional, defaults to https://api.topstepx.com